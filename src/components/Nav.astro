---
import { Image } from 'astro:assets';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/withBase';
import logoImage from '../assets/logo.jpeg';
---

<header class="site-header">
  <div class="nav-grid">
    <a class="brand" href={withBase('/#top')} aria-label={`${siteConfig.name} — accueil`}>
      <Image class="brand-logo" src={logoImage} alt="" width={48} height={48} loading="eager" />
      <span>{siteConfig.name.toUpperCase()}</span>
    </a>
    <nav class="nav-links" aria-label="Navigation principale">
      {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button-link button-link--outline" href="#contact">
        <span class="ember-dot" aria-hidden="true"></span>
        Contact
      </a>
    </nav>
    <details class="mobile-nav">
      <summary class="mobile-nav__toggle">Menu</summary>
      <nav class="mobile-nav__panel" aria-label="Navigation mobile">
        {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button-link" href="#contact">Contact</a>
      </nav>
    </details>
  </div>
</header>
