---
import { navItems } from '../../config/nav.config';
import { siteConfig } from '../../config/site.config';
import { withBase } from '../../lib/withBase';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
---

<header class="sticky top-0 z-40 border-b border-[var(--pb-ink)]/8 bg-[rgb(248_252_252_/_0.88)] backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
    <Logo size="md" />
    <nav class="hidden items-center gap-6 md:flex" aria-label="Navigation principale">
      {
        navItems.map((item) => (
          <a
            href={withBase(item.href)}
            class="text-sm font-medium text-[var(--pb-ink-soft)] transition hover:text-[var(--pb-ink)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <Button href={`tel:${siteConfig.phone.tel}`} variant="secondary" size="md" external class="hidden sm:inline-flex">
        Appeler
      </Button>
      <Button href="/menu" variant="primary" size="md">Voir le menu</Button>
    </div>
  </div>
</header>
