---
import { homeContent } from '../config/home';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/withBase';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>{siteConfig.name.toUpperCase()}</strong>
      <p>{homeContent.footer.tagline}</p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">Nous trouver</p>
      <p>{siteConfig.address.street}</p>
      <p>{siteConfig.address.postalCode} {siteConfig.address.locality}</p>
      <p><a href={`tel:${siteConfig.phoneTel}`}>{siteConfig.phone}</a></p>
      <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">Horaires</p>
      {siteConfig.hours.lines.map((line) => (
        <p>{line.label} : {line.value}</p>
      ))}
      <p>Fermé {siteConfig.hours.closed}</p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">Réseaux</p>
      <ul>
        {siteConfig.social.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
          </li>
        ))}
        {siteConfig.legal.map((item) => (
          <li>
            <a href={withBase(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {siteConfig.name}. Tous droits réservés.</p>
      <p><span class="ember-dot" aria-hidden="true"></span> {homeContent.footer.signal}</p>
    </div>
  </div>
</footer>
