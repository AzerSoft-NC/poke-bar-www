---
import { siteConfig } from '../config/site';
import { getLocale, getMessages, localizedPath } from '../i18n';
import { withBase } from '../lib/withBase';

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const year = new Date().getFullYear();

const socialLabels: Record<(typeof siteConfig.social)[number]['id'], string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
};

const socialIcons: Record<string, string> = {
  Instagram:
    'M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
  Facebook:
    'M14 13.5h2.5l.5-3H14v-1.5c0-.8.2-1.5 1.5-1.5H17V4.5h-2c-2.4 0-4 1.5-4 4V10.5H8.5v3H11V20h3v-6.5z',
};
---

<footer id="contact" class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <strong>{siteConfig.name.toUpperCase()}</strong>
      <p>{t.footer.tagline}</p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">{t.footer.findUs}</p>
      <p class="footer-address">
        <span>
          {siteConfig.address.street}<br />
          {siteConfig.address.postalCode} {siteConfig.address.locality}
        </span>
        {
          siteConfig.mapsUrl && (
            <a
              class="footer-maps"
              href={siteConfig.mapsUrl}
              target="_blank"
              rel="noreferrer"
              aria-label={t.footer.mapsAria}
              title={t.footer.mapsAria}
            >
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"
                />
              </svg>
            </a>
          )
        }
      </p>
      <p><a href={`tel:${siteConfig.phoneTel}`}>{siteConfig.phone}</a></p>
      <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">{t.footer.hours}</p>
      {t.footer.hourLines.map((line) => (
        <p>{line.label} : {line.value}</p>
      ))}
      <p>{t.footer.closedPrefix} {t.footer.closed}</p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow">{t.footer.networks}</p>
      <ul class="footer-social">
        {siteConfig.social.map((item) => {
          const label = socialLabels[item.id];
          return (
            <li>
              <a class="footer-social-link" href={item.href} target="_blank" rel="noreferrer">
                {socialIcons[label] ? (
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d={socialIcons[label]} />
                  </svg>
                ) : null}
                <span>{label}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <ul class="footer-legal">
        {t.footer.legal.map((item) => (
          <li>
            <a href={withBase(localizedPath(locale, item.href))}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {siteConfig.name}. {t.footer.rights}</p>
      <p><span class="ember-dot" aria-hidden="true"></span> {t.footer.signal}</p>
    </div>
  </div>
</footer>
