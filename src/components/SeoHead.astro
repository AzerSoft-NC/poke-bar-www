---
import { siteConfig } from '../config/site';
import { defaultLocale, getLocale, getMessages, locales, switchLocalePath } from '../i18n';
import { withBase } from '../lib/withBase';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
};

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);

const {
  title = t.meta.title,
  description = t.meta.description,
  image = siteConfig.defaultImage,
  type = 'website',
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, siteUrl);
const absoluteImage = new URL(withBase(image), siteUrl);
const pageTitle = title === t.meta.title ? title : `${title} | ${siteConfig.name}`;

const alternates = locales.map((loc) => ({
  loc,
  href: new URL(withBase(switchLocalePath(Astro.url.pathname, loc)), siteUrl).href,
  hreflang: loc === 'fr' ? 'fr' : 'en',
}));
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(withBase(switchLocalePath(Astro.url.pathname, defaultLocale)), siteUrl).href}
/>
<meta property="og:locale" content={t.meta.ogLocale} />
{
  locales
    .filter((loc) => loc !== locale)
    .map((loc) => (
      <meta property="og:locale:alternate" content={getMessages(loc).meta.ogLocale} />
    ))
}
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:image" content={absoluteImage.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage.href} />
{
  structuredData && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )
}
