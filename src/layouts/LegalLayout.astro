---
import BaseLayout from './BaseLayout.astro';

type Props = {
  title: string;
  description: string;
  updated?: string;
};

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <header class="max-w-3xl">
      <h1 class="font-display text-4xl font-extrabold tracking-tight md:text-5xl">{title}</h1>
      {updated && <p class="mt-3 text-sm text-[var(--pb-ink-soft)]">Mise à jour : {updated}</p>}
    </header>
    <div class="prose-legal mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>
