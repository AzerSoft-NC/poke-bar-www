---
import '../styles.css';
import SeoHead from '../components/SeoHead.astro';
import { siteConfig } from '../config/site';
import { getLocale, getMessages } from '../i18n';
import { loadEnv } from '../lib/env';
import { withBase } from '../lib/withBase';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
  enableReveal?: boolean;
};

const { title, description, image, structuredData, enableReveal = siteConfig.effects.reveal } =
  Astro.props;
const { googleSiteVerification } = loadEnv();
const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f7a45" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {enableReveal && (
      <script is:inline>
        document.documentElement.classList.add('reveal-ready');
      </script>
    )}
    <SeoHead title={title} description={description} image={image} structuredData={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.ui.skipToContent}</a>
    <div class="site-shell">
      <slot />
    </div>
    {enableReveal && (
      <script is:inline>
        (() => {
          const elements = Array.from(document.querySelectorAll('.reveal'));

          if (!elements.length) {
            return;
          }

          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          if (prefersReducedMotion || !('IntersectionObserver' in window)) {
            elements.forEach((element) => element.classList.add('is-visible'));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) {
                  return;
                }

                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              });
            },
            {
              rootMargin: '0px 0px -12% 0px',
              threshold: 0.12,
            },
          );

          elements.forEach((element) => observer.observe(element));
        })();
      </script>
    )}
  </body>
</html>
