---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { homeContent } from '../config/home';
import { instagramPostHref, instagramPosts } from '../config/instagram';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/withBase';
import chefImage from '../assets/logo.jpeg';
import detailImage from '../assets/menu.jpeg';
import heroImage from '../assets/com_recent.jpeg';
import menuImage from '../assets/menu.jpeg';
import contactImage from '../assets/com_recent.jpeg';

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const menuPdfHref = withBase(siteConfig.menuPdf);
const whatsappHref = `https://wa.me/${siteConfig.whatsapp}`;
const instagramProfileHref =
  siteConfig.social.find((item) => item.label === 'Instagram')?.href ??
  'https://www.instagram.com/pokebar_cocotiers/';

const thumbModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/insta/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const thumbsByFile = Object.fromEntries(
  Object.entries(thumbModules).map(([path, mod]) => [path.split('/').pop()!, mod.default]),
);
const instagramFeed = instagramPosts.map((post) => {
  const image = thumbsByFile[post.file];
  if (!image) {
    throw new Error(`Missing Instagram thumb asset: ${post.file}`);
  }
  return {
    ...post,
    href: instagramPostHref(post.code),
    image,
  };
});

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: siteConfig.name,
  description: siteConfig.description,
  url: new URL(withBase('/'), siteUrl).href,
  image: new URL(withBase(siteConfig.defaultImage), siteUrl).href,
  telephone: siteConfig.phoneTel,
  email: siteConfig.email,
  servesCuisine: [...siteConfig.restaurant.cuisine],
  priceRange: siteConfig.restaurant.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.address.street,
    addressLocality: siteConfig.address.locality,
    postalCode: siteConfig.address.postalCode,
    addressCountry: siteConfig.address.country,
  },
  openingHoursSpecification: siteConfig.hours.schema.map((block) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [...block.dayOfWeek],
    opens: block.opens,
    closes: block.closes,
  })),
};
---

<BaseLayout image={siteConfig.defaultImage} structuredData={structuredData}>
  <Nav />

  <main id="main">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <Image
        class="media-fill"
        src={heroImage}
        alt="Poké bowl et smoothie Poke Bar Nouméa"
        width={1600}
        height={1200}
        quality={92}
        loading="eager"
        decoding="sync"
      />
      <div class="overlay" style="background: var(--grad-vignette);"></div>
      <div class="overlay" style="background: var(--grad-veil);"></div>
      <div class="hero-content">
        <div class="hero-grid">
          <div class="hero-heading">
            <p class="label-eyebrow reveal">{homeContent.hero.eyebrow}</p>
            <h1 id="hero-title" class="hero-title display reveal reveal-delay-1">
              {homeContent.hero.title[0]}<br />
              <span class="display-italic" style="color: var(--ember);">{homeContent.hero.title[1]}</span
              ><br />
              {homeContent.hero.title[2]}
            </h1>
          </div>

          <div class="hero-copy reveal reveal-delay-2">
            <p>{homeContent.hero.body}</p>
            <div class="hero-actions">
              <a class="button-link" href={menuPdfHref}>
                {homeContent.hero.action} <span aria-hidden="true">-&gt;</span>
              </a>
              <a class="button-link button-link--outline" href={`tel:${siteConfig.phoneTel}`}>
                {homeContent.hero.secondaryAction}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="marquee" aria-label="Valeurs Poke Bar">
      <div class="marquee-track">
        {
          [...homeContent.marquee, ...homeContent.marquee].map((item) => (
            <span>
              {item}
              <b aria-hidden="true">*</b>
            </span>
          ))
        }
      </div>
    </section>

    <section id="concept" class="section concept-section">
      <div class="container section-grid">
        <div class="section-kicker">
          <p class="label-eyebrow reveal">{homeContent.concept.eyebrow}</p>
        </div>
        <h2 class="section-heading display reveal">
          {homeContent.concept.heading[0]}<br />
          <span class="display-italic" style="color: var(--ember);">{homeContent.concept.heading[1]}</span
          ><br />
          {homeContent.concept.heading[2]}
        </h2>

        <div class="text-block reveal reveal-delay-1">
          {homeContent.concept.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <figure class="figure-detail reveal">
          <div class="image-frame aspect-3-4">
            <Image
              src={detailImage}
              alt="Panneau Create your poke — étapes de composition"
              width={1200}
              height={1500}
              loading="lazy"
            />
          </div>
          <figcaption class="label-eyebrow" style="margin-top: 1rem;">
            {homeContent.concept.caption}
          </figcaption>
        </figure>

        <div class="fire-block reveal">
          <div class="quote-block">
            <blockquote>"{homeContent.concept.quote}"</blockquote>
            <p class="label-eyebrow" style="margin-top: 1.5rem;">— {homeContent.concept.quoteByline}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="menu" class="section surface-section">
      <div class="container section-grid">
        <div class="section-kicker">
          <p class="label-eyebrow reveal">{homeContent.tasting.eyebrow}</p>
        </div>
        <h2 class="section-heading display reveal">
          {homeContent.tasting.heading[0]}<br />
          <span class="display-italic" style="color: var(--ember);">{homeContent.tasting.heading[1]}</span
          ><br />
          {homeContent.tasting.heading[2]}
        </h2>

        <aside class="menu-aside reveal" aria-label="Notes menu">
          <div class="image-frame aspect-3-4">
            <Image
              src={menuImage}
              alt="Menu Create your poke en quatre étapes"
              width={1200}
              height={1500}
              loading="lazy"
            />
          </div>
          <p class="label-eyebrow" style="margin-top: 1rem;">{homeContent.tasting.caption}</p>
          <div class="hairline" style="margin-block: 2rem 1.5rem;"></div>
          <p style="color: var(--muted-foreground); line-height: 1.6;">
            {homeContent.tasting.note}
          </p>
          <p style="margin-top: 1.5rem;">
            <a class="button-link" href={menuPdfHref}>
              {homeContent.tasting.pdfLabel} <span aria-hidden="true">-&gt;</span>
            </a>
          </p>
        </aside>

        <ol class="course-list">
          {
            homeContent.tasting.courses.map((course) => (
              <li class="course reveal">
                <span class="course-number">{course.number}</span>
                <h3>
                  {course.title}{' '}
                  {course.accent && <span class="display-italic">{course.accent}</span>}
                </h3>
                <p>{course.body}</p>
                <span class="pairing">{course.pairing}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="chef" class="section">
      <div class="container section-grid">
        <div class="section-kicker">
          <p class="label-eyebrow reveal">{homeContent.chef.eyebrow}</p>
        </div>
        <h2 class="section-heading display reveal">
          {homeContent.chef.heading.line1}<br />
          <span class="display-italic" style="color: var(--ember);">{homeContent.chef.heading.accent}</span>
          {' '}{homeContent.chef.heading.rest}
        </h2>

        <div class="chef-media image-frame aspect-4-5 reveal">
          <Image
            src={chefImage}
            alt="Logo Poke Bar Nouméa"
            width={1200}
            height={1200}
            loading="lazy"
          />
        </div>

        <div class="chef-bio reveal reveal-delay-1">
          <p class="chef-quote">"{homeContent.chef.quote}"</p>
          <div class="hairline" style="margin-block: 2.5rem;"></div>
          <ul class="timeline">
            {
              homeContent.chef.timeline.map((row) => (
                <li>
                  <span class="timeline-label">{row.year}</span>
                  <span>{row.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="interior" class="surface-section interior-section">
      <div class="container interior-head">
        <p class="label-eyebrow reveal">{homeContent.interior.eyebrow}</p>
        <h2 class="display reveal">
          {homeContent.interior.heading.lead}{' '}
          <span class="display-italic" style="color: var(--ember);"
            >{homeContent.interior.heading.accent}</span
          >
          {' '}{homeContent.interior.heading.rest}
        </h2>
        <p class="reveal reveal-delay-1" style="margin-top: 1.25rem;">
          <a
            class="button-link button-link--outline"
            href={instagramProfileHref}
            target="_blank"
            rel="noreferrer"
          >
            {homeContent.interior.profileCta} <span aria-hidden="true">-&gt;</span>
          </a>
        </p>
      </div>

      <ul class="instagram-grid" aria-label="Publications Instagram récentes @pokebar_cocotiers">
        {
          instagramFeed.map((post, index) => (
            <li>
              <a
                class:list={['instagram-cell', post.isVideo && 'instagram-cell--video']}
                href={post.href}
                target="_blank"
                rel="noreferrer"
                aria-label={`Publication Instagram ${index + 1}`}
              >
                <Image
                  src={post.image}
                  alt=""
                  width={640}
                  height={640}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="container section">
        <div class="feature-grid">
          {
            homeContent.interior.features.map((feature) => (
              <section>
                <p class="label-eyebrow">{feature.title}</p>
                <p>{feature.body}</p>
              </section>
            ))
          }
        </div>
        {
          siteConfig.mapsUrl && (
            <p style="margin-top: 2rem;">
              <a class="button-link button-link--outline" href={siteConfig.mapsUrl} target="_blank" rel="noreferrer">
                Ouvrir dans Maps <span aria-hidden="true">-&gt;</span>
              </a>
            </p>
          )
        }
      </div>
    </section>

    <section id="contact" class="section reservation">
      <Image
        class="reservation-bg"
        src={contactImage}
        alt=""
        width={900}
        height={1200}
        loading="lazy"
        aria-hidden="true"
      />
      <div class="overlay" style="background: var(--grad-vignette);"></div>

      <div class="container section-grid">
        <div class="reservation-copy">
          <p class="label-eyebrow reveal">{homeContent.contact.eyebrow}</p>
          <h2 class="display reveal">
            {homeContent.contact.heading[0]}<br />
            <span class="display-italic" style="color: var(--ember);">{homeContent.contact.heading[1]}</span
            ><br />
            {homeContent.contact.heading[2]}
          </h2>
          <p class="reveal reveal-delay-1">{homeContent.contact.body}</p>
          <div class="reservation-facts reveal reveal-delay-2">
            <div>
              <p class="label-eyebrow">Horaires</p>
              {
                siteConfig.hours.lines.map((line) => (
                  <p>
                    {line.label}
                    <br />
                    {line.value}
                  </p>
                ))
              }
            </div>
            <div>
              <p class="label-eyebrow">Fermeture</p>
              <p>{siteConfig.hours.closed}</p>
            </div>
          </div>
        </div>

        <div class="contact-panel contact-card reveal">
          <p class="label-eyebrow">Nous joindre</p>
          <div class="contact-actions">
            <a class="button-link" href={`tel:${siteConfig.phoneTel}`}>
              Appeler {siteConfig.phone} <span aria-hidden="true">-&gt;</span>
            </a>
            <a class="button-link button-link--outline" href={whatsappHref} target="_blank" rel="noreferrer">
              WhatsApp
            </a>
            <a class="button-link button-link--outline" href={`mailto:${siteConfig.email}`}>
              {siteConfig.email}
            </a>
          </div>
          <p style="color: var(--muted-foreground); font-size: 0.85rem; margin-top: 1.25rem;">
            {homeContent.contact.confirmation}
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
