---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site';
import { getMessages, localeHomePath } from '../../i18n';
import { withBase } from '../../lib/withBase';

const t = getMessages('en');
---

<BaseLayout title={t.notFound.title} description={t.notFound.description}>
  <main id="main" class="container" style="padding-block: 6rem; min-height: 70vh;">
    <p class="label-eyebrow">404</p>
    <h1 class="display" style="margin-top: 0.75rem;">{t.notFound.heading}</h1>
    <p style="max-width: 36rem; margin-top: 1rem;">
      {t.notFound.body}
    </p>
    <div class="hero-actions" style="margin-top: 2rem;">
      <a class="button-link" href={withBase(localeHomePath('en'))}>
        {t.notFound.home} <span aria-hidden="true">-&gt;</span>
      </a>
      <a class="button-link button-link--outline" href={`tel:${siteConfig.phoneTel}`}>
        {t.notFound.call} {siteConfig.phone}
      </a>
    </div>
  </main>
</BaseLayout>
