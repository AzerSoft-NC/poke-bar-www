---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/withBase';
---

<BaseLayout title="Page introuvable" description="Cette page n’existe pas.">
  <main id="main" class="container" style="padding-block: 6rem; min-height: 70vh;">
    <p class="label-eyebrow">404</p>
    <h1 class="display" style="margin-top: 0.75rem;">Oups, ce bol est vide</h1>
    <p style="max-width: 36rem; margin-top: 1rem;">
      La page demandée n’existe pas. Revenez à l’accueil ou appelez-nous directement.
    </p>
    <div class="hero-actions" style="margin-top: 2rem;">
      <a class="button-link" href={withBase('/')}>Retour à l’accueil <span aria-hidden="true">-&gt;</span></a>
      <a class="button-link button-link--outline" href={`tel:${siteConfig.phoneTel}`}>
        Appeler {siteConfig.phone}
      </a>
    </div>
  </main>
</BaseLayout>
