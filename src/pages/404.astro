---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { siteConfig } from '../config/site.config';
---

<BaseLayout title="Page introuvable" description="Cette page n’existe pas.">
  <div class="mx-auto flex min-h-[70vh] max-w-6xl flex-col justify-center px-4 py-20 md:px-6">
    <p class="font-display text-sm font-bold uppercase tracking-[0.2em] text-[var(--pb-reef)]">404</p>
    <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight md:text-6xl">
      Oups, ce bol est vide
    </h1>
    <p class="mt-4 max-w-xl text-lg text-[var(--pb-ink-soft)]">
      La page demandée n’existe pas. Revenez à l’accueil ou appelez-nous directement.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/" variant="primary" size="lg">Retour à l’accueil</Button>
      <Button href={`tel:${siteConfig.phone.tel}`} variant="secondary" size="lg" external>
        Appeler {siteConfig.phone.display}
      </Button>
    </div>
  </div>
</BaseLayout>
